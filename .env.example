# Kopyalayarak .env oluştur. CHANGE_ME değerlerini kendi uzun parolalarınla değiştir.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/ledgerline
DATABASE_USER=ledgerline_migrator
DATABASE_PASSWORD=CHANGE_ME_runtime_database_password
MIGRATION_DATABASE_PASSWORD=CHANGE_ME_migration_database_password
DB_POOL_SIZE=12
DB_MIGRATE=true
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Yalnızca proxy'nin gerçek socket IP'leri. Proxy X-Real-IP başlığını üzerine yazarak göndermeli.
TRUSTED_PROXY_IPS=
# İlk admin hesabı için gerekli; sonraki başlatmalarda mevcut parolayı değiştirmez.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_unique_admin_password
